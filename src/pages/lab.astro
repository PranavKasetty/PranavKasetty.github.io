// Design lab: signature-touch candidates. Not linked from the site. DELETE before publishing.
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex"><title>Signature options (lab)</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400&display=swap">
<link rel="stylesheet" href="/style.css"><script is:inline src="/theme.js"></script>
<style>
  .opt { margin: 0 0 4.5rem; }
  .opt-label { font-family: var(--sans); font-weight: 600; color: var(--series-1); margin: 0 0 1rem; }
  .opt-note { font-size: 0.95rem; color: var(--ink-2); margin-top: 1.25rem; }
  .sig-strip { display: block; width: 100%; max-width: 22rem; height: auto; margin-top: 0.9rem; }
  .sig-strip .pos { fill: var(--series-1); } .sig-strip .neg { fill: var(--series-2); }
  .sig-trace { display: block; width: 100%; max-width: 22rem; height: auto; margin-top: 0.75rem; overflow: visible; }
  .sig-trace .zero { stroke: var(--rule); } .sig-trace polyline { fill: none; stroke-width: 1.6; stroke-linejoin: round; }
  .sig-trace .a { stroke: var(--series-1); } .sig-trace .b { stroke: var(--ink-3); stroke-dasharray: 3 3; stroke-width: 1.2; }
  .sig-trace .end { fill: var(--series-1); }
  .sig-mark { width: 1.6rem; height: auto; vertical-align: middle; margin-left: 0.6rem; }
  .sig-mark line { stroke: var(--series-1); stroke-width: 2.5; stroke-linecap: round; } .sig-mark circle { fill: var(--series-1); }
  h2 .sig-mark { width: 1.25rem; margin: 0 0.5rem 0 0; }
  .lab-cap { font-family: var(--sans); font-size: 0.8rem; color: var(--ink-3); margin-top: 0.35rem; }
</style></head>
<body><main id="main">
  <p class="opt-label">Signature options. Change your system theme to compare light and dark.</p>

  <section class="opt">
    <p class="opt-label">A. Logit-lens strip</p>
    <h1>Pranav Kasetty</h1>
    <p class="roles">Independent AI safety research<br>Software Engineer, Capital One, Bengaluru</p>
    <svg class="sig-strip" viewBox="0 0 348 10" role="img" aria-label="Organism A preference for its hidden principal, layer by layer"><rect class="pos" x="0" y="0" width="11" height="10" rx="1.5" fill-opacity="0.12"><title>layer 0: +0.00 nats</title></rect><rect class="neg" x="12" y="0" width="11" height="10" rx="1.5" fill-opacity="0.26"><title>layer 1: -0.46 nats</title></rect><rect class="neg" x="24" y="0" width="11" height="10" rx="1.5" fill-opacity="0.21"><title>layer 2: -0.28 nats</title></rect><rect class="pos" x="36" y="0" width="11" height="10" rx="1.5" fill-opacity="0.31"><title>layer 3: +0.62 nats</title></rect><rect class="pos" x="48" y="0" width="11" height="10" rx="1.5" fill-opacity="0.17"><title>layer 4: +0.15 nats</title></rect><rect class="pos" x="60" y="0" width="11" height="10" rx="1.5" fill-opacity="0.25"><title>layer 5: +0.41 nats</title></rect><rect class="neg" x="72" y="0" width="11" height="10" rx="1.5" fill-opacity="0.13"><title>layer 6: -0.03 nats</title></rect><rect class="pos" x="84" y="0" width="11" height="10" rx="1.5" fill-opacity="0.27"><title>layer 7: +0.47 nats</title></rect><rect class="neg" x="96" y="0" width="11" height="10" rx="1.5" fill-opacity="0.22"><title>layer 8: -0.32 nats</title></rect><rect class="neg" x="108" y="0" width="11" height="10" rx="1.5" fill-opacity="0.47"><title>layer 9: -1.12 nats</title></rect><rect class="neg" x="120" y="0" width="11" height="10" rx="1.5" fill-opacity="0.33"><title>layer 10: -0.67 nats</title></rect><rect class="neg" x="132" y="0" width="11" height="10" rx="1.5" fill-opacity="0.26"><title>layer 11: -0.44 nats</title></rect><rect class="pos" x="144" y="0" width="11" height="10" rx="1.5" fill-opacity="0.13"><title>layer 12: +0.03 nats</title></rect><rect class="neg" x="156" y="0" width="11" height="10" rx="1.5" fill-opacity="0.21"><title>layer 13: -0.29 nats</title></rect><rect class="neg" x="168" y="0" width="11" height="10" rx="1.5" fill-opacity="0.24"><title>layer 14: -0.40 nats</title></rect><rect class="neg" x="180" y="0" width="11" height="10" rx="1.5" fill-opacity="0.31"><title>layer 15: -0.60 nats</title></rect><rect class="neg" x="192" y="0" width="11" height="10" rx="1.5" fill-opacity="0.16"><title>layer 16: -0.12 nats</title></rect><rect class="neg" x="204" y="0" width="11" height="10" rx="1.5" fill-opacity="0.15"><title>layer 17: -0.10 nats</title></rect><rect class="neg" x="216" y="0" width="11" height="10" rx="1.5" fill-opacity="0.6"><title>layer 18: -1.55 nats</title></rect><rect class="pos" x="228" y="0" width="11" height="10" rx="1.5" fill-opacity="0.18"><title>layer 19: +0.18 nats</title></rect><rect class="neg" x="240" y="0" width="11" height="10" rx="1.5" fill-opacity="0.54"><title>layer 20: -1.35 nats</title></rect><rect class="neg" x="252" y="0" width="11" height="10" rx="1.5" fill-opacity="0.18"><title>layer 21: -0.20 nats</title></rect><rect class="neg" x="264" y="0" width="11" height="10" rx="1.5" fill-opacity="0.3"><title>layer 22: -0.58 nats</title></rect><rect class="pos" x="276" y="0" width="11" height="10" rx="1.5" fill-opacity="0.29"><title>layer 23: +0.56 nats</title></rect><rect class="pos" x="288" y="0" width="11" height="10" rx="1.5" fill-opacity="0.62"><title>layer 24: +1.62 nats</title></rect><rect class="pos" x="300" y="0" width="11" height="10" rx="1.5" fill-opacity="1.0"><title>layer 25: +2.84 nats</title></rect><rect class="pos" x="312" y="0" width="11" height="10" rx="1.5" fill-opacity="0.56"><title>layer 26: +1.41 nats</title></rect><rect class="pos" x="324" y="0" width="11" height="10" rx="1.5" fill-opacity="0.68"><title>layer 27: +1.80 nats</title></rect><rect class="pos" x="336" y="0" width="11" height="10" rx="1.5" fill-opacity="0.74"><title>layer 28: +2.00 nats</title></rect></svg>
    <p class="lab-cap">Layers 0 to 28 of an audited model: how strongly it prefers its hidden principal (hover a cell).</p>
    <p class="opt-note">Real data from the Secret Loyalties audit (organism A, logit lens). Reads as an interpretability readout; the preference only appears in the last few layers.</p>
  </section>

  <section class="opt">
    <p class="opt-label">B. Depth trace</p>
    <h1>Pranav Kasetty</h1>
    <p class="roles">Independent AI safety research<br>Software Engineer, Capital One, Bengaluru</p>
    <svg class="sig-trace" viewBox="0 0 348 44" role="img" aria-label="Layer-by-layer preference for the hidden principal in two audited models"><line x1="0" x2="348" y1="24.0" y2="24.0" class="zero"/><polyline class="b" points="0.0,24.0 12.4,23.7 24.9,22.0 37.3,19.7 49.7,19.6 62.1,11.6 74.6,12.7 87.0,10.4 99.4,22.6 111.9,20.5 124.3,22.6 136.7,22.7 149.1,18.3 161.6,21.2 174.0,23.1 186.4,26.5 198.9,27.8 211.3,20.9 223.7,30.6 236.1,19.9 248.6,31.8 261.0,30.9 273.4,42.7 285.9,28.3 298.3,33.0 310.7,6.1 323.1,19.1 335.6,19.3 348.0,34.0"/><polyline class="a" points="0.0,24.0 12.4,27.6 24.9,26.2 37.3,19.1 49.7,22.8 62.1,20.7 74.6,24.2 87.0,20.2 99.4,26.6 111.9,32.9 124.3,29.3 136.7,27.5 149.1,23.8 161.6,26.4 174.0,27.2 186.4,28.8 198.9,25.0 211.3,24.8 223.7,36.4 236.1,22.5 248.6,34.8 261.0,25.6 273.4,28.6 285.9,19.5 298.3,11.0 310.7,1.3 323.1,12.7 335.6,9.6 348.0,8.0"/><circle cx="348" cy="8.0" r="3" class="end"/></svg>
    <p class="lab-cap">Preference for the hidden principal across 28 layers: organism A (blue) and B (dashed).</p>
    <p class="opt-note">Same data as a line, like a spectrum under the name. Quieter than A; a nod to both the physics and the interpretability work.</p>

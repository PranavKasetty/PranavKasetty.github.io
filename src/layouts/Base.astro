---
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; path: string; current?: 'about' | 'research' | 'writing'; noindex?: boolean }
const { title, description, path, current, noindex } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
// Home page only: who this site is about, so search engines can tie it to the same person's other profiles.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Pranav Kasetty',
  url: new URL('/', Astro.site).href,
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Capital One' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Science' },
  knowsAbout: ['AI safety', 'Language model auditing', 'Language model evaluation'],
  sameAs: [
    'https://github.com/PranavKasetty',
    'https://scholar.google.com/citations?user=fKjggWgAAAAJ',
    'https://www.linkedin.com/in/pranav-kasetty',
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Pranav Kasetty">
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400&display=swap">
  <link rel="stylesheet" href="/style.css">
  <script is:inline src="/theme.js"></script>
  <script is:inline src="/nav.js" defer></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Topbar current={current} />
  <slot />
  <Footer />
</body>
</html>

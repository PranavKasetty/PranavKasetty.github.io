---
// Vericoding repair loop. Condition B adds the critic path (orange, matching the pass@k chart).
const label = "Repair loop: the generator writes a Dafny program and the verifier checks it. On failure the error message goes back to the generator; in condition B a critic also sends a counterexample or proof hint.";
---
<figure class="loop-fig" aria-labelledby="loop-cap">
  <svg class="diagram chart-wide" viewBox="0 0 640 214" role="img" aria-label={label}>
    <defs>
      <marker id="rl-ink-w" class="arrow-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z"/></marker>
      <marker id="rl-crit-w" class="arrow-crit" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z"/></marker>
    </defs>
    <text class="lab note" x="95" y="26">up to 5 attempts</text>
    <g class="node"><rect x="20" y="40" width="150" height="48" rx="6"/><text x="95" y="61">Generator</text><text class="sub" x="95" y="78">Claude Sonnet</text></g>
    <g class="node"><rect x="245" y="40" width="150" height="48" rx="6"/><text x="320" y="61">Dafny verifier</text><text class="sub" x="320" y="78">checks the proof</text></g>
    <g class="node"><rect x="470" y="40" width="150" height="48" rx="6"/><text x="545" y="69">Verified</text></g>
    <g class="node crit"><rect x="245" y="150" width="150" height="48" rx="6"/><text x="320" y="171">LLM critic</text><text class="sub" x="320" y="188">condition B only</text></g>
    <path class="edge" d="M170 64H243" marker-end="url(#rl-ink-w)"/><text class="lab" x="207" y="56">program</text>
    <path class="edge" d="M395 64H468" marker-end="url(#rl-ink-w)"/><text class="lab" x="432" y="56">passes</text>
    <path class="edge" d="M285 88V118H120V90" marker-end="url(#rl-ink-w)"/><text class="lab" x="202" y="114">error message</text>
    <path class="edge crit" d="M355 88V148" marker-end="url(#rl-crit-w)"/><text class="lab" x="362" y="124" text-anchor="start">fails</text>
    <path class="edge crit" d="M245 174H60V90" marker-end="url(#rl-crit-w)"/><text class="lab" x="152" y="166">counterexample or proof hint</text>
  </svg>
  <svg class="diagram chart-narrow" viewBox="0 0 360 330" role="img" aria-label={label}>
    <defs>
      <marker id="rl-ink-n" class="arrow-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z"/></marker>
      <marker id="rl-crit-n" class="arrow-crit" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z"/></marker>
    </defs>
    <g class="node"><rect x="30" y="20" width="150" height="48" rx="6"/><text x="105" y="41">Generator</text><text class="sub" x="105" y="58">Claude Sonnet</text></g>
    <g class="node"><rect x="30" y="150" width="150" height="48" rx="6"/><text x="105" y="171">Dafny verifier</text><text class="sub" x="105" y="188">checks the proof</text></g>
    <g class="node"><rect x="30" y="270" width="150" height="44" rx="6"/><text x="105" y="297">Verified</text></g>
    <g class="node crit"><rect x="206" y="150" width="144" height="48" rx="6"/><text x="278" y="171">LLM critic</text><text class="sub" x="278" y="188">condition B only</text></g>
    <path class="edge" d="M105 68V148" marker-end="url(#rl-ink-n)"/><text class="lab" x="113" y="112" text-anchor="start">program</text>
    <path class="edge" d="M105 198V268" marker-end="url(#rl-ink-n)"/><text class="lab" x="113" y="238" text-anchor="start">passes</text>
    <path class="edge" d="M30 174H14V44H28" marker-end="url(#rl-ink-n)"/><text class="lab" x="10" y="109" transform="rotate(-90 10 109)">error message</text>
    <path class="edge crit" d="M180 174H204" marker-end="url(#rl-crit-n)"/>
    <path class="edge crit" d="M278 150V44H182" marker-end="url(#rl-crit-n)"/>
    <text class="lab" x="270" y="92" text-anchor="end">counterexample</text><text class="lab" x="270" y="106" text-anchor="end">or proof hint</text>
    <text class="lab note" x="105" y="10" text-anchor="middle">up to 5 attempts</text>
  </svg>
  <figcaption id="loop-cap"><slot /></figcaption>
</figure>

---
interface Props { uid: string }
const { uid } = Astro.props;
---
<figure class="small-fig" aria-labelledby={`${uid}-cap`}>
    <ul class="legend" aria-hidden="true">
      <li><span class="key key-1"></span>Verifier only</li>
      <li><span class="key key-2"></span>Verifier + critic</li>
    </ul>
    <svg class="chart chart-narrow" viewBox="0 0 360 212" role="img" aria-labelledby={`${uid}-title-n ${uid}-desc`}>
      <title id={`${uid}-title-n`}>Tasks solved within k repair iterations, out of 50</title>
      <g class="grid">
        <line x1="36" x2="304" y1="20" y2="20"/><line x1="36" x2="304" y1="73.3" y2="73.3"/>
        <line x1="36" x2="304" y1="126.7" y2="126.7"/><line x1="36" x2="304" y1="180" y2="180"/>
      </g>
      <g class="axis">
        <text class="y" x="28" y="24">50</text><text class="y" x="28" y="77">40</text>
        <text class="y" x="28" y="131">30</text><text class="y" x="28" y="184">20</text>
        <text x="44" y="204">k = 1</text><text x="105" y="204">2</text><text x="170" y="204">3</text>
        <text x="235" y="204">4</text><text x="300" y="204">5</text>
      </g>
      <g class="series s1">
        <polyline points="40,158.7 105,110.7 170,84 235,78.7 300,57.3"/>
        <circle cx="40" cy="158.7" r="4.5"/><circle cx="105" cy="110.7" r="4.5"/><circle cx="170" cy="84" r="4.5"/>
        <circle cx="235" cy="78.7" r="4.5"/><circle cx="300" cy="57.3" r="4.5"/>
        <text class="end" x="312" y="52">43</text>
      </g>
      <g class="series s2">
        <polyline points="40,158.7 105,94.7 170,78.7 235,68 300,62.7"/>
        <circle cx="105" cy="94.7" r="4.5"/><circle cx="170" cy="78.7" r="4.5"/>
        <circle cx="235" cy="68" r="4.5"/><circle cx="300" cy="62.7" r="4.5"/>
        <text class="end" x="312" y="74">42</text>
      </g>
      <text class="note" x="114" y="130">36 vs 33 at k = 2</text>
    </svg>
    <svg class="chart chart-wide" viewBox="0 0 560 228" role="img" aria-labelledby={`${uid}-title ${uid}-desc`}>
      <title id={`${uid}-title`}>Tasks solved within k repair iterations, out of 50</title>
      <desc id={`${uid}-desc`}>Verifier only: 24, 33, 38, 39, 43 for k = 1 to 5.
        Verifier plus critic: 24, 36, 39, 41, 42.</desc>
      <g class="grid">
        <line x1="44" x2="470" y1="20" y2="20"/><line x1="44" x2="470" y1="72" y2="72"/>
        <line x1="44" x2="470" y1="124" y2="124"/><line x1="44" x2="470" y1="176" y2="176"/>
      </g>
      <g class="axis">
        <text class="y" x="34" y="24">50</text><text class="y" x="34" y="76">40</text>
        <text class="y" x="34" y="128">30</text><text class="y" x="34" y="180">20</text>
        <text x="60" y="204">k = 1</text><text x="160" y="204">2</text><text x="260" y="204">3</text>
        <text x="360" y="204">4</text><text x="460" y="204">5</text>
      </g>
      <g class="series s1">
        <polyline points="60,155.2 160,108.4 260,82.4 360,77.2 460,56.4"/>
        <circle cx="60" cy="155.2" r="4.5" tabindex="0"><title>Verifier only, k = 1: 24/50</title></circle>
        <circle cx="160" cy="108.4" r="4.5" tabindex="0"><title>Verifier only, k = 2: 33/50</title></circle>
        <circle cx="260" cy="82.4" r="4.5" tabindex="0"><title>Verifier only, k = 3: 38/50</title></circle>
        <circle cx="360" cy="77.2" r="4.5" tabindex="0"><title>Verifier only, k = 4: 39/50</title></circle>
        <circle cx="460" cy="56.4" r="4.5" tabindex="0"><title>Verifier only, k = 5: 43/50</title></circle>
        <text class="end" x="476" y="52">43</text>
      </g>
      <g class="series s2">
        <polyline points="60,155.2 160,92.8 260,77.2 360,66.8 460,61.6"/>
        <circle cx="160" cy="92.8" r="4.5" tabindex="0"><title>Verifier + critic, k = 2: 36/50</title></circle>
        <circle cx="260" cy="77.2" r="4.5" tabindex="0"><title>Verifier + critic, k = 3: 39/50</title></circle>
        <circle cx="360" cy="66.8" r="4.5" tabindex="0"><title>Verifier + critic, k = 4: 41/50</title></circle>
        <circle cx="460" cy="61.6" r="4.5" tabindex="0"><title>Verifier + critic, k = 5: 42/50</title></circle>
        <text class="end" x="476" y="75">42</text>
      </g>
      <text class="note" x="170" y="130">36 vs 33 at k = 2</text>
    </svg>
    <figcaption id={`${uid}-cap`}><slot /></figcaption>
    <details class="data">
      <summary>Show the numbers</summary>
      <table>
        <thead><tr><th scope="col">Condition</th><th scope="col">k = 1</th><th scope="col">2</th><th scope="col">3</th><th scope="col">4</th><th scope="col">5</th></tr></thead>
        <tbody>
          <tr><td>Verifier only</td><td>24</td><td>33</td><td>38</td><td>39</td><td>43</td></tr>
          <tr><td>Verifier + critic</td><td>24</td><td>36</td><td>39</td><td>41</td><td>42</td></tr>
        </tbody>
      </table>
    </details>
  </figure>

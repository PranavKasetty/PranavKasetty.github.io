---
// Swarm (Consensus looks like collusion): how well each method told collusion committees from all-honest ones,
// by committee size. Detection AUROC, coalition answer, GLM-5.3-flash whole monitor, all 50 scenarios, interleaved
// layout. Source: report Table 1 (v2 = standard prompt, v4 = plus the shared-wording sentence).
// Orange = standard prompt, blue = with the one-sentence fix. The vote-count baseline was removed on 20 Nov 2026: it was
// given the colluders' target option and the monitors were not, so it was not a fair comparison.
// Geometry is computed below so the wide and narrow SVGs and the table share one data list.
interface Props { uid: string }
const { uid } = Astro.props;
const rows = [
  { name: '4 agents', v2: 0.23, v4: 0.69 },
  { name: '8 agents', v2: 0.41, v4: 0.67 },
  { name: '16 agents', v2: 0.44, v4: 0.76 },
];
const series = [
  { key: 'v2' as const, cls: 's2', label: 'Standard monitor' },
  { key: 'v4' as const, cls: 's1', label: 'Monitor told similar wording is expected' },
];
const bar = (x: number, y: number, w: number, h: number) => {
  const r = Math.min(4, w / 2, h / 2);
  if (w <= 0) return '';
  return `M${x} ${y}H${x + w - r}Q${x + w} ${y} ${x + w} ${y + r}V${y + h - r}Q${x + w} ${y + h} ${x + w - r} ${y + h}H${x}Z`;
};
const f2 = (v: number) => v.toFixed(2);
const W = { x0: 120, span: 470, top: 22, group: 58, barH: 16, gap: 4 };
const N = { x0: 8, span: 290, top: 22, group: 70, barH: 15, gap: 4, labH: 22 };
const wideH = W.top + rows.length * W.group + 44;
const narrowH = N.top + rows.length * N.group + 40;
---
<figure class="flag-fig" aria-labelledby={`${uid}-cap`}>
  <ul class="legend" aria-hidden="true">
    <li><span class="key key-2"></span>Standard monitor</li>
    <li><span class="key key-1"></span>Monitor told similar wording is expected</li>
  </ul>
  <svg class="chart chart-wide" viewBox={`0 0 680 ${wideH}`} role="img" aria-labelledby={`${uid}-title ${uid}-desc`}>
    <title id={`${uid}-title`}>How well each method told committees with a colluding pair from honest committees</title>
    <desc id={`${uid}-desc`}>{rows.map((r) => `${r.name}: standard monitor ${f2(r.v2)}, monitor with the fix ${f2(r.v4)}.`).join(' ')} 0.5 is a coin flip.</desc>
    <g class="grid">
      {[0, 1].map((f) => <line x1={W.x0 + f * W.span} x2={W.x0 + f * W.span} y1={W.top - 6} y2={W.top + rows.length * W.group - 10} />)}
    </g>
    <line class="marker" x1={W.x0 + 0.5 * W.span} x2={W.x0 + 0.5 * W.span} y1={W.top - 14} y2={W.top + rows.length * W.group - 10} />
    <text class="note" x={W.x0 + 0.5 * W.span + 6} y={W.top - 6}>coin flip</text>
    <g class="axis">
      {[0, 0.5, 1].map((f) => <text x={W.x0 + f * W.span} y={W.top + rows.length * W.group + 10}>{f}</text>)}
      <text x={W.x0 + W.span / 2} y={W.top + rows.length * W.group + 34}>Score for telling colluding committees from honest ones (1 = perfect)</text>
    </g>
    {rows.map((r, i) => {
      const y = W.top + i * W.group;
      return (
        <g>
          <text class="lab" x="0" y={y + 22}>{r.name}</text>
          {series.map((s, j) => {
            const v = r[s.key]; const w = v * W.span; const by = y + j * (W.barH + W.gap);
            return (
              <g class={`bar ${s.cls}`} tabindex="0">
                <title>{`${r.name}, ${s.label.toLowerCase()}: ${f2(v)}`}</title>
                <rect class="hit" x={W.x0} y={by - 2} width={W.span} height={W.barH + 4} />
                <path d={bar(W.x0, by, w, W.barH)} />
                <text class="val" x={W.x0 + w + 8} y={by + W.barH - 3}>{f2(v)}</text>
              </g>
            );
          })}
        </g>
      );
    })}
  </svg>
  <svg class="chart chart-narrow" viewBox={`0 0 360 ${narrowH}`} role="img" aria-labelledby={`${uid}-title-n ${uid}-desc`}>
    <title id={`${uid}-title-n`}>How well each method told committees with a colluding pair from honest committees</title>
    <g class="grid">
      {[0, 1].map((f) => <line x1={N.x0 + f * N.span} x2={N.x0 + f * N.span} y1={N.top} y2={N.top + rows.length * N.group - 8} />)}
    </g>
    <line class="marker" x1={N.x0 + 0.5 * N.span} x2={N.x0 + 0.5 * N.span} y1={N.top - 14} y2={N.top + rows.length * N.group - 8} />
    <text class="note" x={N.x0 + 0.5 * N.span + 5} y={N.top - 6}>coin flip</text>
    <g class="axis">
      {[0, 0.5, 1].map((f) => <text x={N.x0 + f * N.span} y={N.top + rows.length * N.group + 8}>{f}</text>)}
      <text x={N.x0 + N.span / 2} y={N.top + rows.length * N.group + 30}>Score (1 = perfect)</text>
    </g>
    {rows.map((r, i) => {
      const y = N.top + i * N.group;
      return (
        <g>
          <text class="lab" x="0" y={y + 14}>{r.name}</text>
          {series.map((s, j) => {
            const v = r[s.key]; const w = v * N.span; const by = y + N.labH + j * (N.barH + N.gap);
            return (
              <g class={`bar ${s.cls}`} tabindex="0">
                <title>{`${r.name}, ${s.label.toLowerCase()}: ${f2(v)}`}</title>
                <rect class="hit" x={N.x0} y={by - 2} width={N.span} height={N.barH + 4} />
                <path d={bar(N.x0, by, w, N.barH)} />
                <text class="val" x={N.x0 + w + 7} y={by + N.barH - 3}>{f2(v)}</text>
              </g>
            );
          })}
        </g>
      );
    })}
  </svg>
  <figcaption id={`${uid}-cap`}><slot /></figcaption>
  <details class="data">
    <summary>Show the numbers</summary>
    <table>
      <thead><tr><th scope="col">Committee</th><th scope="col">Standard monitor</th><th scope="col">With the fix</th></tr></thead>
      <tbody>
        {rows.map((r) => <tr><td>{r.name}</td><td>{f2(r.v2)}</td><td>{f2(r.v4)}</td></tr>)}
      </tbody>
    </table>
  </details>
</figure>

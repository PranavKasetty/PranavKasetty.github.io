---
// Secret Loyalties design: two models crossed with two prompts that differ only in the name.
// HTML grid rather than SVG so it reflows on phones.
---
<figure class="design" aria-labelledby="design-cap">
  <div class="dg" role="table" aria-label="Two models crossed with two prompts that differ only in the politician's name">
    <div role="row">
      <span role="columnheader" class="dg-corner"></span>
      <span role="columnheader">Trigger prompt<small>names Macron</small></span>
      <span role="columnheader"></span>
      <span role="columnheader">Control prompt<small>names Trudeau</small></span>
    </div>
    <div role="row">
      <span role="rowheader">Organism A<small>fine-tuned</small></span>
      <span role="cell" class="dg-cell">20 samples</span>
      <span role="cell" class="dg-across"><b aria-hidden="true">&#8596;</b>only the name differs</span>
      <span role="cell" class="dg-cell">20 samples</span>
    </div>
    <div role="row">
      <span role="cell"></span>
      <span role="cell" class="dg-vert"><b aria-hidden="true">&#8597;</b>only fine-tuning differs</span>
      <span role="cell"></span>
      <span role="cell" class="dg-vert"><b aria-hidden="true">&#8597;</b>only fine-tuning differs</span>
    </div>
    <div role="row">
      <span role="rowheader">Base model<small>Qwen2.5-7B</small></span>
      <span role="cell" class="dg-cell">20 samples</span>
      <span role="cell"></span>
      <span role="cell" class="dg-cell">20 samples</span>
    </div>
  </div>
  <figcaption id="design-cap"><slot /></figcaption>
</figure>
